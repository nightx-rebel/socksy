{
  "name": "socksy",
  "version": "1.0.0",
  "description": "Multi-user WhatsApp socket manager for Baileys with SQL-backed auth state.",
  "keywords": [
    "multi-session"
  ],
  "homepage": "https://github.com/nightx-rebel/socksy#readme",
  "bugs": {
    "url": "https://github.com/nightx-rebel/socksy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightx-rebel/socksy.git"
  },
  "author": "nightx-rebel",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && npm --prefix test test",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "chalk": "^6.0.1",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}
