{
  "name": "wa-multi-socket",
  "version": "1.0.0",
  "description": "Multi-user WhatsApp socket manager for Baileys with SQL-backed auth state.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "@hapi/boom": "^10.0.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}